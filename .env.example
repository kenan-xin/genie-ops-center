# Genie Ops Center environment contract
#
# Copy this file to .env for local development. It is intentionally safe to
# commit: replace placeholders locally and never commit .env or real secrets.
#
# The runtime validates DATABASE_URL, BETTER_AUTH_SECRET, and PUBLIC_BASE_URL
# before it serves traffic. Full deployment guidance: docs/deployment.md.

# ── App runtime ─────────────────────────────────────────────────────────────
# Used by pnpm dev. The Docker image sets production itself.
NODE_ENV=development

# Local Docker Postgres uses the POSTGRES_* values below. For an external DB,
# replace the whole URL; do not also expect POSTGRES_* to change it.
DATABASE_URL=postgres://genie:genie@localhost:5432/genie

# A stable random string, at least 32 characters. Generate locally:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# This deployment's browser-visible base URL. Auth cookies and reset links use it.
PUBLIC_BASE_URL=http://localhost:3000

# The app listens on this internal port. Keep 3000 for the repository Dockerfile
# and set Coolify's domain internal port to the same value if you change it.
PORT=3000

# Comma-separated proxy IPs/CIDRs trusted for X-Forwarded-For. Leave empty for
# local development. Do not use 0.0.0.0/0. Cloudflare + Traefik needs the
# documented Cloudflare ranges in both services.
AUTH_TRUSTED_PROXIES=

# Transactional email for invitations and password reset. Empty is suitable for
# host-based pnpm dev, which logs links instead of delivering them.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# First-admin bootstrap. It runs only when the user table is empty. Use a strong
# temporary password, then clear ADMIN_PASSWORD after the first successful boot.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Comma-separated HTTPS origins permitted for chat upstreams and embedded
# iframes. Empty means those corresponding solution types cannot be configured.
GENIE_CHAT_API_ALLOWED_ORIGINS=
ALLOWED_IFRAME_ORIGINS=https://loan-review-app.vercel.app

# Wait limit for the startup migration advisory lock, in milliseconds.
LOCK_TIMEOUT_MS=120000

# ── Docker Compose helpers only ─────────────────────────────────────────────
# These create/configure the Postgres container for docker-compose.local.yml
# and docker-compose.smoke.yml. They do not affect an external DATABASE_URL.
POSTGRES_USER=genie
POSTGRES_PASSWORD=genie
POSTGRES_DB=genie

# Host port for the local Postgres container. Change if 5432 is already used.
POSTGRES_PORT=5432

# Host port for the app in docker-compose.smoke.yml. This does not alter PORT
# inside the container.
APP_PORT=3000

# Genie Ops Center environment contract
#
# Copy this file to .env for local development. It is intentionally safe to
# commit: replace placeholders locally and never commit .env or real secrets.
#
# Full deployment guidance: docs/deployment.md.

# ── Required app runtime values ──────────────────────────────────────────────
# The runtime refuses to start without all three values.
# Local Docker Postgres uses the POSTGRES_* values below. For an external DB,
# replace the whole URL; do not also expect POSTGRES_* to change it.
DATABASE_URL=postgres://genie:genie@localhost:5432/genie

# A stable random string, at least 32 characters. Generate locally:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# This deployment's browser-visible base URL. Auth cookies and reset links use it.
PUBLIC_BASE_URL=http://localhost:3000

# ── Conditional feature configuration ───────────────────────────────────────
# Uncomment both values to send real invitations and password resets. The
# sender must belong to a verified Resend domain. Without an API key, local
# development logs the generated links instead. Resend's shared sender
# onboarding@resend.dev reaches only the address that owns the Resend account,
# and rejects every other recipient with a 403.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@agilgenie.ai

# First administrator: only for an empty database. Use a strong temporary
# password, then remove ADMIN_PASSWORD after the first successful login.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Chat solutions: comma-separated HTTPS origins for the server-side upstream.
# Empty disables chat streaming. Embedded solutions accept any public HTTPS URL.
# GENIE_CHAT_API_ALLOWED_ORIGINS=https://chat.example.com

# ── Optional app runtime controls ────────────────────────────────────────────
# Next.js sets this for host development and the Docker image sets production.
# Override it only for a specific test runner or nonstandard host.
# NODE_ENV=development

# Container listening port. Keep 3000 for the repository Dockerfile. If changed,
# update the reverse proxy's upstream port too.
# PORT=3000

# Comma-separated proxy IPs/CIDRs trusted for X-Forwarded-For. Leave empty for
# local development. Do not use 0.0.0.0/0. Add only the published ranges of
# proxy services you operate.
# AUTH_TRUSTED_PROXIES=

# Startup migration advisory-lock wait limit, in milliseconds.
# LOCK_TIMEOUT_MS=120000

# ── Docker Compose helpers only ─────────────────────────────────────────────
# These create/configure the Postgres container for docker-compose.local.yml
# and docker-compose.smoke.yml. They do not affect an external DATABASE_URL.
# POSTGRES_USER=genie
# POSTGRES_PASSWORD=genie
# POSTGRES_DB=genie

# Host port for the local Postgres container. Change if 5432 is already used.
# POSTGRES_PORT=5432

# Host port for the app in docker-compose.smoke.yml. This does not alter PORT
# inside the container.
# APP_PORT=3000

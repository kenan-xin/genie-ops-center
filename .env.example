# ──────────────────────────────────────────────────────────────────────────────
# Genie Workspace — per-deployment env contract (ticket 03b).
# One image, one deployment per customer. Copy to `.env` and fill in. Secrets
# are supplied ONLY via env — never baked into the image. Clear ADMIN_PASSWORD
# after first boot.
# ──────────────────────────────────────────────────────────────────────────────

# Postgres connection — used by the app (Drizzle pool), the migrator, and docker-compose.
DATABASE_URL=postgres://genie:genie@localhost:5432/genie

# better-auth — a stable random string, MIN 32 chars. Generate: openssl rand -base64 32
# Boot fails fast if shorter.
BETTER_AUTH_SECRET=
# Public base URL of this deployment (auth cookies/reset links, server-side tRPC).
PUBLIC_BASE_URL=http://localhost:3000

# First-admin bootstrap. Seeded ONLY if the user table is empty; the password is
# re-checked against the shared strength rule. Clear ADMIN_PASSWORD after first boot.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Approved origins for per-solution chat streaming endpoints (FR-ADM-S-03).
# Comma-separated, e.g. https://dev-genie.001.gs. A Chat solution's apiEndpoint
# origin must be on this list (SSRF allow-list + default-seed + rotation point).
# Empty ⇒ no chat solution can be saved or streamed until an origin is approved.
GENIE_CHAT_API_ALLOWED_ORIGINS=

# iframe allow-list for embedded solutions (CSP frame-src). Comma-separated origins.
ALLOWED_IFRAME_ORIGINS=

# ── docker-compose only (ignored by the app itself) ──────────────────────────
# Override the host port the app is published on.
APP_PORT=3000
# Max ms a replica waits for the migration advisory lock before failing loudly.
LOCK_TIMEOUT_MS=120000
